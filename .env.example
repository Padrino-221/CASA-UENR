# ── Database ─────────────────────────────────────────────────────────────
# Local dev: your local PostgreSQL.
# Vercel / production: a hosted Postgres connection string (Neon recommended,
# the app auto-detects *.neon.tech and uses the serverless driver).
DATABASE_URL="postgresql://user:password@localhost:5432/uchms?schema=public"

# ── Auth.js / NextAuth ───────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Required on Vercel so Auth.js trusts the deployment host.
AUTH_TRUST_HOST="true"

# Optional: pin the canonical URL. Not required when AUTH_TRUST_HOST=true.
# NEXTAUTH_URL="https://your-app.vercel.app"

# ── Object storage (Neon, S3-compatible) ─────────────────────────────────
# Uploaded CMS images are stored here and served from the public bucket URL.
AWS_ENDPOINT_URL_S3="https://<project-id>.storage.<region>.aws.neon.tech"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-2"
AWS_S3_BUCKET="casa-uenr"
# Optional: override the public base URL (defaults to <endpoint>/<bucket>).
# AWS_S3_PUBLIC_URL="https://<project-id>.storage.<region>.aws.neon.tech/casa-uenr"

# ── SEO (optional) ───────────────────────────────────────────────────────
# Public site origin used for canonical URLs, sitemap and Open Graph tags.
# Auto-detected on Vercel; set explicitly for custom domains.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
